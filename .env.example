# ── Required ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
RESEND_API_KEY=your-resend-api-key
APP_URL=https://your-domain.com
MCP_SERVER_URL=https://api.your-domain.com

# ── Optional ──
SYNC_SECRET=any-random-string
RESEND_FROM=YourApp <notifications@your-domain.com>
GOOGLE_REDIRECT_URI=https://api.your-domain.com/api/google/callback
PORT=3001

# ── CORS ──
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ── Frontend (baked at build time via Docker args) ──
VITE_API_URL=/api
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
