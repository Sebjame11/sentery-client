RESEND_API_KEY=re_xxxxxxxxxxxx
# Get your free key at https://resend.com then replace the value above

# Supabase (needed for the Meetings feature — backend writes via service role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Calendar OAuth (create at https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback

# Where the app runs (used to build booking links + MCP consent redirect)
APP_URL=http://localhost:5173

# Public base URL of THIS backend. Used by the MCP OAuth endpoints (metadata,
# token, registration) so clients like ChatGPT / Claude can discover them.
# In production set this to your deployed API URL, e.g. https://api.sentery.app
MCP_SERVER_URL=http://localhost:3001
